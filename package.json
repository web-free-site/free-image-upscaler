{
  "name": "slop-image-upscaler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Client-side AI image upscaler (Real-ESRGAN) — nothing uploaded",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meigo/slop-image-upscaler.git"
  },
  "homepage": "https://slop-image-upscaler.meigo.workers.dev/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@lucide/svelte": "^1.48.0",
    "onnxruntime-web": "^1.30.0",
    "pica": "^10.0.3"
